// Contrabajo con arco (Biblioteca Racoon)
// fuente: meatbass
<control>
default_path=contrabajo-arco/

<global>
ampeg_release=0.40
amp_veltrack=85

<region> sample=A0-v1.flac pitch_keycenter=21 lokey=0 hikey=22 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=69819 loop_end=96114
<region> sample=C1-v1.flac pitch_keycenter=24 lokey=23 hikey=27 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=90265 loop_end=116136
<region> sample=Fs1-v1.flac pitch_keycenter=30 lokey=28 hikey=31 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=69000 loop_end=93810
<region> sample=A1-v1.flac pitch_keycenter=33 lokey=32 hikey=36 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72840 loop_end=98530
<region> sample=Ds2-v1.flac pitch_keycenter=39 lokey=37 hikey=40 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=68847 loop_end=94376
<region> sample=Fs2-v1.flac pitch_keycenter=42 lokey=41 hikey=45 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=47848 loop_end=74047
<region> sample=C3-v1.flac pitch_keycenter=48 lokey=46 hikey=49 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81290 loop_end=107276
<region> sample=Ds3-v1.flac pitch_keycenter=51 lokey=50 hikey=54 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64544 loop_end=90961
<region> sample=A3-v1.flac pitch_keycenter=57 lokey=55 hikey=58 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72840 loop_end=99111
<region> sample=C4-v1.flac pitch_keycenter=60 lokey=59 hikey=63 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=52028 loop_end=78353
<region> sample=Fs4-v1.flac pitch_keycenter=66 lokey=64 hikey=67 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=50273 loop_end=76586
<region> sample=A4-v1.flac pitch_keycenter=69 lokey=68 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77006 loop_end=103388
