// Chelo pizzicato (Biblioteca Racoon)
// fuente: bigcatcello
<control>
default_path=chelo-pizz/

<global>
ampeg_release=0.20
amp_veltrack=85

<region> sample=C2-v1.flac pitch_keycenter=36 lokey=0 hikey=37 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Ds2-v1.flac pitch_keycenter=39 lokey=38 hikey=40 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Fs2-v1.flac pitch_keycenter=42 lokey=41 hikey=43 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A2-v1.flac pitch_keycenter=45 lokey=44 hikey=46 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C3-v1.flac pitch_keycenter=48 lokey=47 hikey=49 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Ds3-v1.flac pitch_keycenter=51 lokey=50 hikey=54 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A3-v1.flac pitch_keycenter=57 lokey=55 hikey=58 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C4-v1.flac pitch_keycenter=60 lokey=59 hikey=61 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Ds4-v1.flac pitch_keycenter=63 lokey=62 hikey=64 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Fs4-v1.flac pitch_keycenter=66 lokey=65 hikey=67 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A4-v1.flac pitch_keycenter=69 lokey=68 hikey=70 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C5-v1.flac pitch_keycenter=72 lokey=71 hikey=127 lovel=1 hivel=127 loop_mode=no_loop
