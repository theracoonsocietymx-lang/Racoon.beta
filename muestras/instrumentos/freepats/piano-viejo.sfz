// Piano viejo de cantina (Biblioteca Racoon)
// fuente: freepats_oldpiano
<control>
default_path=piano-viejo/

<global>
ampeg_release=0.30
amp_veltrack=85

<region> sample=Gs0-v1.flac pitch_keycenter=20 lokey=0 hikey=22 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C1-v1.flac pitch_keycenter=24 lokey=23 hikey=26 lovel=1 hivel=127 loop_mode=no_loop
