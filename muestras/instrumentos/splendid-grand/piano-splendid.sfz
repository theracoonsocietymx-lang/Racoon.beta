// Piano de cola Splendid (Akai) (Biblioteca Racoon)
// fuente: splendid
<control>
default_path=piano-splendid/

<global>
ampeg_release=0.45
amp_veltrack=85

<region> sample=B0-v1.flac pitch_keycenter=23 lokey=0 hikey=25 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=B0-v2.flac pitch_keycenter=23 lokey=0 hikey=25 lovel=64 hivel=127 loop_mode=no_loop
