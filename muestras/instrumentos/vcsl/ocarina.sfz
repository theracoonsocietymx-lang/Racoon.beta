// Ocarina (Biblioteca Racoon)
// fuente: vcsl
<control>
default_path=ocarina/

<global>
ampeg_release=0.20
amp_veltrack=85

<region> sample=A4-v1.flac pitch_keycenter=69 lokey=0 hikey=70 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=85337 loop_end=111814
