// Armónica diatónica en Do (Biblioteca Racoon)
// fuente: vcsl
<control>
default_path=armonica-do/

<global>
ampeg_release=0.20
amp_veltrack=85

<region> sample=C4-v1.flac pitch_keycenter=60 lokey=0 hikey=62 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=93832 loop_end=120287
<region> sample=E4-v1.flac pitch_keycenter=64 lokey=63 hikey=68 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=93772 loop_end=120000
<region> sample=C5-v1.flac pitch_keycenter=72 lokey=69 hikey=74 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=60368 loop_end=86751
<region> sample=E5-v1.flac pitch_keycenter=76 lokey=75 hikey=77 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81229 loop_end=107665
<region> sample=G5-v1.flac pitch_keycenter=79 lokey=78 hikey=81 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=89580 loop_end=116037
<region> sample=C6-v1.flac pitch_keycenter=84 lokey=82 hikey=86 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64557 loop_end=90966
<region> sample=E6-v1.flac pitch_keycenter=88 lokey=87 hikey=89 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=56199 loop_end=82657
<region> sample=G6-v1.flac pitch_keycenter=91 lokey=90 hikey=93 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77096 loop_end=103506
<region> sample=C7-v1.flac pitch_keycenter=96 lokey=94 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=93819 loop_end=120253
