// Piano vertical Knight (Biblioteca Racoon)
// fuente: vcsl
<control>
default_path=piano-vertical-knight/

<global>
ampeg_release=0.35
amp_veltrack=85

<region> sample=A0-v1.flac pitch_keycenter=21 lokey=0 hikey=23 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=A0-v2.flac pitch_keycenter=21 lokey=0 hikey=23 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=Cs1-v1.flac pitch_keycenter=25 lokey=24 hikey=28 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=Cs1-v2.flac pitch_keycenter=25 lokey=24 hikey=28 lovel=64 hivel=127 loop_mode=no_loop
