// Órgano de tubos (Biblioteca Racoon)
// fuente: vcsl
<control>
default_path=organo-de-tubos/

<global>
ampeg_release=0.50
amp_veltrack=85

<region> sample=C2-v1.flac pitch_keycenter=36 lokey=0 hikey=39 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=60389 loop_end=87051
<region> sample=Fs2-v1.flac pitch_keycenter=42 lokey=40 hikey=45 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81344 loop_end=107539
<region> sample=C3-v1.flac pitch_keycenter=48 lokey=46 hikey=49 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77110 loop_end=103354
<region> sample=Ds3-v1.flac pitch_keycenter=51 lokey=50 hikey=54 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64544 loop_end=90847
<region> sample=A3-v1.flac pitch_keycenter=57 lokey=55 hikey=60 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Ds4-v1.flac pitch_keycenter=63 lokey=61 hikey=66 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=89589 loop_end=115837
<region> sample=A4-v1.flac pitch_keycenter=69 lokey=67 hikey=72 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=60344 loop_end=86847
<region> sample=Ds5-v1.flac pitch_keycenter=75 lokey=73 hikey=78 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=56189 loop_end=82621
<region> sample=A5-v1.flac pitch_keycenter=81 lokey=79 hikey=82 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=85399 loop_end=111832
<region> sample=C6-v1.flac pitch_keycenter=84 lokey=83 hikey=87 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=52025 loop_end=78481
<region> sample=Fs6-v1.flac pitch_keycenter=90 lokey=88 hikey=93 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=47848 loop_end=74303
<region> sample=C7-v1.flac pitch_keycenter=96 lokey=94 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=89639 loop_end=116096
