// Órgano renacentista 8 pies (Biblioteca Racoon)
// fuente: vcsl
<control>
default_path=organo-renacentista/

<global>
ampeg_release=0.30
amp_veltrack=85

<region> sample=C2-v1.flac pitch_keycenter=36 lokey=0 hikey=38 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77110 loop_end=103476
