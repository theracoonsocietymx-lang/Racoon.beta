<region> sample=C4-v2.flac pitch_keycenter=60 lokey=59 hikey=64 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=Gs4-v1.flac pitch_keycenter=68 lokey=65 hikey=70 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=Gs4-v2.flac pitch_keycenter=68 lokey=65 hikey=70 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=C5-v1.flac pitch_keycenter=72 lokey=71 hikey=74 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=C5-v2.flac pitch_keycenter=72 lokey=71 hikey=74 lovel=64 hivel=127 loop_mode=no_loop
