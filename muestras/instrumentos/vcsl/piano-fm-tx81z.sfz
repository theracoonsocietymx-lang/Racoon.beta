<region> sample=C2-v2.flac pitch_keycenter=36 lokey=35 hikey=38 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=E2-v1.flac pitch_keycenter=40 lokey=39 hikey=44 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=E2-v2.flac pitch_keycenter=40 lokey=39 hikey=44 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=C3-v1.flac pitch_keycenter=48 lokey=45 hikey=50 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=C3-v2.flac pitch_keycenter=48 lokey=45 hikey=50 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=E3-v1.flac pitch_keycenter=52 lokey=51 hikey=54 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=E3-v2.flac pitch_keycenter=52 lokey=51 hikey=54 lovel=64 hivel=127 loop_mode=no_loop
