// Piano FM TX81Z (Biblioteca Racoon)
// fuente: vcsl
<control>
default_path=piano-fm-tx81z/

<global>
ampeg_release=0.30
amp_veltrack=85

<region> sample=C0-v1.flac pitch_keycenter=12 lokey=0 hikey=14 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=C0-v2.flac pitch_keycenter=12 lokey=0 hikey=14 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=E0-v1.flac pitch_keycenter=16 lokey=15 hikey=18 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=E0-v2.flac pitch_keycenter=16 lokey=15 hikey=18 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=Gs0-v1.flac pitch_keycenter=20 lokey=19 hikey=24 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=Gs0-v2.flac pitch_keycenter=20 lokey=19 hikey=24 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=E1-v1.flac pitch_keycenter=28 lokey=25 hikey=30 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=E1-v2.flac pitch_keycenter=28 lokey=25 hikey=30 lovel=64 hivel=127 loop_mode=no_loop
<region> sample=Gs1-v1.flac pitch_keycenter=32 lokey=31 hikey=34 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=Gs1-v2.flac pitch_keycenter=32 lokey=31 hikey=34 lovel=64 hivel=127 loop_mode=no_loop
