// Oboe (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=oboe/

<global>
ampeg_release=0.25
amp_veltrack=85

<region> sample=As3-v1.flac pitch_keycenter=58 lokey=0 hikey=60 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=93829 loop_end=120112
