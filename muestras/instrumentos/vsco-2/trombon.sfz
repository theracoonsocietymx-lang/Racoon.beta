// Trombón tenor (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=trombon/

<global>
ampeg_release=0.25
amp_veltrack=85

<region> sample=As1-v1.flac pitch_keycenter=34 lokey=0 hikey=35 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=47848 loop_end=73580
<region> sample=Cs2-v1.flac pitch_keycenter=37 lokey=36 hikey=38 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77239 loop_end=103965
