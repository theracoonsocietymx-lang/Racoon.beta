<region> sample=F2-v1.flac pitch_keycenter=41 lokey=41 hikey=43 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=68763 loop_end=95532
<region> sample=As2-v1.flac pitch_keycenter=46 lokey=44 hikey=48 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=89820 loop_end=115926
<region> sample=D3-v1.flac pitch_keycenter=50 lokey=49 hikey=51 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=93698 loop_end=119827
