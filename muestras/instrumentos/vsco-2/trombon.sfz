<region> sample=C4-v1.flac pitch_keycenter=60 lokey=57 hikey=60 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=60389 loop_end=86516
<region> sample=Cs4-v1.flac pitch_keycenter=61 lokey=61 hikey=62 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81207 loop_end=107617
<region> sample=Ds4-v1.flac pitch_keycenter=63 lokey=63 hikey=64 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=85415 loop_end=111778
<region> sample=F4-v1.flac pitch_keycenter=65 lokey=65 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77049 loop_end=103439
