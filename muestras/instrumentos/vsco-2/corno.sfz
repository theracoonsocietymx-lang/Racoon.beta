// Corno francés (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=corno/

<global>
ampeg_release=0.35
amp_veltrack=85

<region> sample=A1-v1.flac pitch_keycenter=33 lokey=0 hikey=34 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72840 loop_end=98553
<region> sample=C2-v1.flac pitch_keycenter=36 lokey=35 hikey=37 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=47848 loop_end=73511
<region> sample=Ds2-v1.flac pitch_keycenter=39 lokey=38 hikey=41 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=68847 loop_end=94945
<region> sample=G2-v1.flac pitch_keycenter=43 lokey=42 hikey=44 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=89829 loop_end=115950
<region> sample=As2-v1.flac pitch_keycenter=46 lokey=45 hikey=48 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81426 loop_end=107228
<region> sample=D3-v1.flac pitch_keycenter=50 lokey=49 hikey=51 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=60352 loop_end=86738
<region> sample=F3-v1.flac pitch_keycenter=53 lokey=52 hikey=55 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=93862 loop_end=120366
<region> sample=A3-v1.flac pitch_keycenter=57 lokey=56 hikey=58 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77006 loop_end=103456
<region> sample=C4-v1.flac pitch_keycenter=60 lokey=59 hikey=67 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64569 loop_end=90876
<region> sample=D5-v1.flac pitch_keycenter=74 lokey=68 hikey=75 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=68700 loop_end=95111
<region> sample=F5-v1.flac pitch_keycenter=77 lokey=76 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=56188 loop_end=82687
