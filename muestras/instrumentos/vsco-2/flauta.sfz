// Flauta (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=flauta/

<global>
ampeg_release=0.25
amp_veltrack=85

<region> sample=C4-v1.flac pitch_keycenter=60 lokey=0 hikey=62 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=85471 loop_end=111631
