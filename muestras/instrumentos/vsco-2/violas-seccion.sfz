// Sección de violas (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=violas-seccion/

<global>
ampeg_release=0.45
amp_veltrack=85

<region> sample=C3-v1.flac pitch_keycenter=48 lokey=0 hikey=50 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64569 loop_end=90674
<region> sample=E3-v1.flac pitch_keycenter=52 lokey=51 hikey=53 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=85531 loop_end=111746
