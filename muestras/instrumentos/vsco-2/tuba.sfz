// Tuba (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=tuba/

<global>
ampeg_release=0.25
amp_veltrack=85

<region> sample=F1-v1.flac pitch_keycenter=29 lokey=0 hikey=31 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=60397 loop_end=86095
<region> sample=As1-v1.flac pitch_keycenter=34 lokey=32 hikey=36 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=52079 loop_end=77849
<region> sample=Ds2-v1.flac pitch_keycenter=39 lokey=37 hikey=40 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=68847 loop_end=94855
<region> sample=F2-v1.flac pitch_keycenter=41 lokey=41 hikey=43 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=47848 loop_end=74088
<region> sample=As2-v1.flac pitch_keycenter=46 lokey=44 hikey=48 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=89820 loop_end=115949
<region> sample=D3-v1.flac pitch_keycenter=50 lokey=49 hikey=51 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64520 loop_end=91239
<region> sample=F3-v1.flac pitch_keycenter=53 lokey=52 hikey=55 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=91254 loop_end=117693
<region> sample=As3-v1.flac pitch_keycenter=58 lokey=56 hikey=60 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72928 loop_end=99395
<region> sample=D4-v1.flac pitch_keycenter=62 lokey=61 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72857 loop_end=99309
