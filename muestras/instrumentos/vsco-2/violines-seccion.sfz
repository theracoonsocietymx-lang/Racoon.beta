<region> sample=D4-v1.flac pitch_keycenter=62 lokey=61 hikey=64 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81193 loop_end=107696
<region> sample=Fs4-v1.flac pitch_keycenter=66 lokey=65 hikey=67 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A4-v1.flac pitch_keycenter=69 lokey=68 hikey=70 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C5-v1.flac pitch_keycenter=72 lokey=71 hikey=74 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77062 loop_end=103372
<region> sample=E5-v1.flac pitch_keycenter=76 lokey=75 hikey=77 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81229 loop_end=107629
<region> sample=G5-v1.flac pitch_keycenter=79 lokey=78 hikey=81 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72887 loop_end=99321
<region> sample=B5-v1.flac pitch_keycenter=83 lokey=82 hikey=84 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=68728 loop_end=95132
<region> sample=D6-v1.flac pitch_keycenter=86 lokey=85 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64557 loop_end=90963
