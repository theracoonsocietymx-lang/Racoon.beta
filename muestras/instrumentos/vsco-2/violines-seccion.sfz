// Sección de violines (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=violines-seccion/

<global>
ampeg_release=0.45
amp_veltrack=85

<region> sample=G3-v1.flac pitch_keycenter=55 lokey=0 hikey=56 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=68736 loop_end=94875
