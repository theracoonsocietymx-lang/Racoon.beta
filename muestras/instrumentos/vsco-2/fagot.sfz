<region> sample=A2-v1.flac pitch_keycenter=45 lokey=44 hikey=46 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=81171 loop_end=107629
<region> sample=C3-v1.flac pitch_keycenter=48 lokey=47 hikey=51 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=56208 loop_end=82502
<region> sample=G3-v1.flac pitch_keycenter=55 lokey=52 hikey=57 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64558 loop_end=90874
<region> sample=C4-v1.flac pitch_keycenter=60 lokey=58 hikey=61 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77110 loop_end=103404
<region> sample=Ds4-v1.flac pitch_keycenter=63 lokey=62 hikey=65 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=77067 loop_end=103417
<region> sample=Gs4-v1.flac pitch_keycenter=68 lokey=66 hikey=70 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=56182 loop_end=82727
