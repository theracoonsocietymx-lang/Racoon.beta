// Fagot (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=fagot/

<global>
ampeg_release=0.25
amp_veltrack=85

<region> sample=As1-v1.flac pitch_keycenter=34 lokey=0 hikey=35 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=85932 loop_end=110908
<region> sample=Cs2-v1.flac pitch_keycenter=37 lokey=36 hikey=39 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=52046 loop_end=77502
