// Trompeta staccato (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=trompeta-staccato/

<global>
ampeg_release=0.10
amp_veltrack=85

<region> sample=F3-v1.flac pitch_keycenter=53 lokey=0 hikey=55 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A3-v1.flac pitch_keycenter=57 lokey=56 hikey=58 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C4-v1.flac pitch_keycenter=60 lokey=59 hikey=61 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Ds4-v1.flac pitch_keycenter=63 lokey=62 hikey=64 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=F4-v1.flac pitch_keycenter=65 lokey=65 hikey=66 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=G4-v1.flac pitch_keycenter=67 lokey=67 hikey=68 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=As4-v1.flac pitch_keycenter=70 lokey=69 hikey=72 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=D5-v1.flac pitch_keycenter=74 lokey=73 hikey=75 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=F5-v1.flac pitch_keycenter=77 lokey=76 hikey=79 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A5-v1.flac pitch_keycenter=81 lokey=80 hikey=82 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C6-v1.flac pitch_keycenter=84 lokey=83 hikey=127 lovel=1 hivel=127 loop_mode=no_loop
