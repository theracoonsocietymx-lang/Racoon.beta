// Sección de chelos (Biblioteca Racoon)
// fuente: vsco
<control>
default_path=chelos-seccion/

<global>
ampeg_release=0.45
amp_veltrack=85

<region> sample=C2-v1.flac pitch_keycenter=36 lokey=0 hikey=38 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=93832 loop_end=120140
