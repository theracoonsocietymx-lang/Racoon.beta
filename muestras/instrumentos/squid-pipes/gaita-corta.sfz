// Gaita corta (Biblioteca Racoon)
// fuente: squidpipes
<control>
default_path=gaita-corta/

<global>
ampeg_release=0.10
amp_veltrack=85

<region> sample=G3-v1.flac pitch_keycenter=55 lokey=0 hikey=57 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=B3-v1.flac pitch_keycenter=59 lokey=58 hikey=60 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=D4-v1.flac pitch_keycenter=62 lokey=61 hikey=64 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Fs4-v1.flac pitch_keycenter=66 lokey=65 hikey=68 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=As4-v1.flac pitch_keycenter=70 lokey=69 hikey=72 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=D5-v1.flac pitch_keycenter=74 lokey=73 hikey=75 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=F5-v1.flac pitch_keycenter=77 lokey=76 hikey=79 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A5-v1.flac pitch_keycenter=81 lokey=80 hikey=83 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Cs6-v1.flac pitch_keycenter=85 lokey=84 hikey=87 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=F6-v1.flac pitch_keycenter=89 lokey=88 hikey=90 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Gs6-v1.flac pitch_keycenter=92 lokey=91 hikey=94 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C7-v1.flac pitch_keycenter=96 lokey=95 hikey=127 lovel=1 hivel=127 loop_mode=no_loop
