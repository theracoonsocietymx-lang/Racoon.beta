// Bajo Horse Pulse (Biblioteca Racoon)
// fuente: horsepulse
<control>
default_path=bajo-horse-pulse/

<global>
ampeg_release=0.15
amp_veltrack=85

<region> sample=D2-v1.flac pitch_keycenter=38 lokey=0 hikey=39 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=E2-v1.flac pitch_keycenter=40 lokey=40 hikey=41 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=G2-v1.flac pitch_keycenter=43 lokey=42 hikey=44 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=A2-v1.flac pitch_keycenter=45 lokey=45 hikey=46 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C3-v1.flac pitch_keycenter=48 lokey=47 hikey=49 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=D3-v1.flac pitch_keycenter=50 lokey=50 hikey=51 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=F3-v1.flac pitch_keycenter=53 lokey=52 hikey=54 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=G3-v1.flac pitch_keycenter=55 lokey=55 hikey=56 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=As3-v1.flac pitch_keycenter=58 lokey=57 hikey=59 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=C4-v1.flac pitch_keycenter=60 lokey=60 hikey=61 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=Ds4-v1.flac pitch_keycenter=63 lokey=62 hikey=64 lovel=1 hivel=127 loop_mode=no_loop
<region> sample=F4-v1.flac pitch_keycenter=65 lokey=65 hikey=127 lovel=1 hivel=127 loop_mode=no_loop
