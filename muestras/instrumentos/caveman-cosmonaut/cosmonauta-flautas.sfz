// Cosmonauta: flautas (Biblioteca Racoon)
// fuente: caveman
<control>
default_path=cosmonauta-flautas/

<global>
ampeg_release=0.40
amp_veltrack=85

<region> sample=G3-v1.flac pitch_keycenter=55 lokey=0 hikey=57 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64558 loop_end=90997
