// Cosmonauta: bajo (Biblioteca Racoon)
// fuente: caveman
<control>
default_path=cosmonauta-bajo/

<global>
ampeg_release=0.20
amp_veltrack=85

<region> sample=C2-v1.flac pitch_keycenter=36 lokey=0 hikey=37 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=36155 loop_end=61799
