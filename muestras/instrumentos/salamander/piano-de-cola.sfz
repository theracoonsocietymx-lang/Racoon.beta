// Piano de cola Salamander (Biblioteca Racoon)
// fuente: salamander
<control>
default_path=piano-de-cola/

<global>
ampeg_release=0.45
amp_veltrack=85

<region> sample=A0-v1.flac pitch_keycenter=21 lokey=0 hikey=22 lovel=1 hivel=63 loop_mode=no_loop
<region> sample=A0-v2.flac pitch_keycenter=21 lokey=0 hikey=22 lovel=64 hivel=127 loop_mode=no_loop
