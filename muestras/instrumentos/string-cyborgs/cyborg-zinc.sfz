// Cuerdas cyborg Zinc (Biblioteca Racoon)
// fuente: stringcyborgs
<control>
default_path=cyborg-zinc/

<global>
ampeg_release=0.50
amp_veltrack=85

<region> sample=A0-v1.flac pitch_keycenter=21 lokey=0 hikey=23 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=64020 loop_end=88078
<region> sample=Cs1-v1.flac pitch_keycenter=25 lokey=24 hikey=27 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=56361 loop_end=80548
<region> sample=Fs1-v1.flac pitch_keycenter=30 lokey=28 hikey=32 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=55399 loop_end=80191
<region> sample=As1-v1.flac pitch_keycenter=34 lokey=33 hikey=36 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=69006 loop_end=93982
<region> sample=D2-v1.flac pitch_keycenter=38 lokey=37 hikey=40 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72857 loop_end=98686
<region> sample=G2-v1.flac pitch_keycenter=43 lokey=41 hikey=45 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=56244 loop_end=82344
<region> sample=B2-v1.flac pitch_keycenter=47 lokey=46 hikey=49 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=52119 loop_end=78192
<region> sample=E3-v1.flac pitch_keycenter=52 lokey=50 hikey=54 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=63278 loop_end=89233
<region> sample=Gs3-v1.flac pitch_keycenter=56 lokey=55 hikey=58 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=55170 loop_end=81291
<region> sample=C4-v1.flac pitch_keycenter=60 lokey=59 hikey=62 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=85471 loop_end=111932
<region> sample=F4-v1.flac pitch_keycenter=65 lokey=63 hikey=67 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=57759 loop_end=84040
<region> sample=A4-v1.flac pitch_keycenter=69 lokey=68 hikey=127 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=25289 loop_end=51734
