// Cuerdas cyborg Blackheart (Biblioteca Racoon)
// fuente: stringcyborgs
<control>
default_path=cyborg-blackheart/

<global>
ampeg_release=0.50
amp_veltrack=85

<region> sample=C2-v1.flac pitch_keycenter=36 lokey=0 hikey=37 lovel=1 hivel=127 loop_mode=loop_continuous loop_start=72930 loop_end=99221
